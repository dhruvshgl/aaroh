DATABASE_URL="postgresql://aaroh:aaroh@localhost:5432/aaroh"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Testing only. When true, any email + password logs in.
TEST_LOGIN_MODE="false"

# Required for career analysis and chat. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=""
AI_MODEL="gpt-5-mini"
AI_MODEL_CHAT="gpt-5-nano"

# Daily analysis runs and hourly chat messages per user.
ANALYSIS_DAILY_LIMIT="5"
CHAT_HOURLY_LIMIT="40"

# Optional OAuth. Buttons appear only when a provider is fully configured.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""
