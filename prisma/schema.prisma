generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum StageStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       CareerProfile?
  resumes       Resume[]
  analyses      Analysis[]
  reports       CareerReport[]
  paths         CareerPath[]
  roadmaps      Roadmap[]
  projects      Project[]
  conversations Conversation[]
  messages      Message[]
  aiRuns        AiRun[]
  rateLimits    RateLimit[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CareerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole        String?
  yearsOfExperience  String?
  industry           String?
  region             String?
  enjoys             String?  @db.Text
  dislikes           String?  @db.Text
  currentLearning    String?  @db.Text
  careerConcern      String?
  anythingElse       String?  @db.Text
  goalText           String?  @db.Text
  timeframe          String?
  targetEnvironment  String?
  interests          String[] @default([])
  onboardingStep     String   @default("background")
  onboardingComplete Boolean  @default(false)
  resumeSkipped      Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  education          Education[]
  skills             Skill[]
}

model Education {
  id             String        @id @default(cuid())
  profileId      String
  profile        CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  degree         String
  field          String?
  institution    String?
  graduationYear Int?
}

model Skill {
  id                String        @id @default(cuid())
  profileId         String
  profile           CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  selfReportedLevel String?

  @@index([profileId])
}

model Resume {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  extractedText String?      @db.Text
  parsedData    Json?
  status        ResumeStatus @default(UPLOADED)
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  analyses      Analysis[]

  @@index([userId])
}

model Analysis {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId        String?
  resume          Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status          AnalysisStatus @default(QUEUED)
  analysisVersion Int            @default(1)
  promptVersion   Int
  model           String?
  error           String?        @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  stages          AnalysisStage[]
  report          CareerReport?
  aiRuns          AiRun[]

  @@index([userId, createdAt])
}

model AnalysisStage {
  id          String      @id @default(cuid())
  analysisId  String
  analysis    Analysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  key         String
  label       String
  sortOrder   Int
  status      StageStatus @default(PENDING)
  error       String?     @db.Text
  output      Json?
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([analysisId, key])
  @@index([analysisId, sortOrder])
}

model CareerReport {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId             String   @unique
  analysis               Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  snapshot               Json
  strengths              Json
  gaps                   Json
  skills                 Json
  targetCareer           Json
  opportunities          Json
  recommendations        Json
  resumeInsights         Json
  alignmentScore         Int
  alignmentBreakdown     Json
  alignmentExplanation   String   @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  paths                  CareerPath[]
  roadmaps               Roadmap[]

  @@index([userId, createdAt])
}

model CareerPath {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId           String
  report             CareerReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  roleName           String
  summary            String       @db.Text
  whyIdentified      String       @db.Text
  transferableSkills Json
  missingSkills      Json
  difficulty         String
  nextStep           String       @db.Text
  transitionPath     Json
  experiments        Json
  fitScore           Int
  fitLabel           String
  createdAt          DateTime     @default(now())

  @@index([userId])
  @@index([reportId])
}

model Roadmap {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId     String
  report       CareerReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  targetRole   String
  version      Int            @default(1)
  isCurrent    Boolean        @default(true)
  hoursPerWeek Int?
  notes        String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  phases       RoadmapPhase[]
  projects     Project[]

  @@index([userId, isCurrent])
}

model RoadmapPhase {
  id          String    @id @default(cuid())
  roadmapId   String
  roadmap     Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  sortOrder   Int
  title       String
  description String    @db.Text
  duration    String
  objective   String    @db.Text
  skills      Json
  topics      Json
  resources   Json
  evidence    String    @db.Text
  completedAt DateTime?

  @@index([roadmapId, sortOrder])
}

model Project {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId       String?
  roadmap         Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  title           String
  description     String        @db.Text
  whyItMatters    String        @db.Text
  skills          Json
  requirements    Json
  architecture    String?       @db.Text
  expectedOutcome String?       @db.Text
  resumeEvidence  String?       @db.Text
  status          ProjectStatus @default(NOT_STARTED)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model AiRun {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisId    String?
  analysis      Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  kind          String
  model         String
  promptVersion Int
  durationMs    Int?
  inputTokens   Int?
  outputTokens  Int?
  status        String
  error         String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([userId, action, windowStart])
}
